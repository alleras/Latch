{
  "name": "latch",
  "version": "0.1.3",
  "private": true,
  "description": "A focused desktop SQL workspace.",
  "author": "Agustin Lleras",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:win:x64": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win nsis zip --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.7",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "monaco-editor": "^0.55.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-data-grid": "^7.0.0-beta.61",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.5"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "26.15.6",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
